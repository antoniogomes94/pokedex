{"id":446,"name":"munchlax","speciesId":446,"dex":446,"form":"normal","generation":4,"types":["normal"],"stats":{"hp":135,"attack":85,"defense":40,"special-attack":40,"special-defense":85,"speed":5},"abilities":[{"name":"pickup","hidden":false},{"name":"thick-fat","hidden":false},{"name":"gluttony","hidden":true}],"height":6,"weight":1050,"baseExp":78,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/446.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/446.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/446.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/446.ogg","genus":"Big Eater Pokémon","flavor":[{"version":"diamond","text":"It wolfs down its weight in food once a day, swallowing food whole with almost no chewing."},{"version":"pearl","text":"It hides food under its long body hair. However, it forgets it has hidden the food."},{"version":"platinum","text":"In its desperation to gulp down food, it forgets about the food it has hidden under its fur."},{"version":"heartgold","text":"It conceals food under the long fur on its body. It carts around this food stash and swallows it without chewing."},{"version":"sun","text":"It needs to consume its own weight in food every day. As far as flavor is concerned, it’s indifferent."},{"version":"moon","text":"When it finds something that looks like it might be edible, it goes right ahead and swallows it whole. That’s why it gets fatter day by day."},{"version":"ultra-sun","text":"It hides food under its long fur, but it sometimes forgets about it and causes a stinky disturbance."},{"version":"ultra-moon","text":"Anything that looks edible, Munchlax will go on and swallow whole. Its stomach is tough enough to handle it even if the food has gone rotten."},{"version":"sword","text":"Stuffing itself with vast amounts of food is its only concern. Whether the food is rotten or fresh, yummy or tasteless—it does not care."},{"version":"shield","text":"It stores food beneath its fur. It might share just one bite, but only if it really trusts you."},{"version":"legends-arceus","text":"Its robust stomach allows it to nonchalantly devour even rotted matter. It pays frequent visits to villages, seeking out food scraps intended for compost."}],"genderRate":1,"captureRate":50,"eggGroups":["no-eggs"],"isLegendary":false,"isMythical":false,"evolution":{"species":"munchlax","speciesId":446,"evolvesTo":[{"conditions":["Felicidade alta"],"species":"snorlax","speciesId":143,"evolvesTo":[]}]},"varieties":[{"id":446,"name":"munchlax","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/446.png"}],"games":[8,9,10,11,14,15,16,17,18,20,23,24,25],"moves":[{"id":5,"learn":[[20,"tm",0]]},{"id":6,"learn":[[20,"tm",0]]},{"id":7,"learn":[[9,"tutor",0],[10,"tutor",0],[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":8,"learn":[[9,"tutor",0],[10,"tutor",0],[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":9,"learn":[[9,"tutor",0],[10,"tutor",0],[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":18,"learn":[[8,"egg",0],[9,"egg",0],[10,"egg",0],[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[23,"egg",0]]},{"id":25,"learn":[[20,"tm",0]]},{"id":29,"learn":[[10,"tutor",0]]},{"id":33,"learn":[[8,"lv",1],[9,"lv",1],[10,"lv",1],[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[23,"lv",1],[24,"lv",5],[25,"lv",1]]},{"id":34,"learn":[[8,"lv",33],[9,"lv",33],[10,"lv",33],[11,"lv",36],[14,"lv",36],[15,"lv",25],[16,"lv",25],[17,"lv",25],[18,"lv",25],[20,"lv",28],[20,"tm",0],[23,"lv",28],[25,"lv",28],[25,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":38,"learn":[[8,"egg",0],[9,"egg",0],[10,"egg",0],[11,"egg",0],[14