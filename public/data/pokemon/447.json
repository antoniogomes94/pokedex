{"id":447,"name":"riolu","speciesId":447,"dex":447,"form":"normal","generation":4,"types":["fighting"],"stats":{"hp":40,"attack":70,"defense":40,"special-attack":35,"special-defense":40,"speed":60},"abilities":[{"name":"steadfast","hidden":false},{"name":"inner-focus","hidden":false},{"name":"prankster","hidden":true}],"height":7,"weight":202,"baseExp":57,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/447.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/447.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/447.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/447.ogg","genus":"Emanation Pokémon","flavor":[{"version":"diamond","text":"The aura that emanates from its body intensifies to alert others if it is afraid or sad."},{"version":"pearl","text":"Its body is lithe yet powerful. It can crest three mountains and cross two canyons in one night."},{"version":"platinum","text":"It has the peculiar power of being able to see emotions such as joy and rage in the form of waves."},{"version":"heartgold","text":"They communicate with one another using their auras. They are able to run all through the night."},{"version":"black-2","text":"It uses the shapes of auras, which change according to emotion, to communicate with others."},{"version":"sun","text":"It can discern the physical and emotional states of people, Pokémon, and other natural things from the shape of their aura waves."},{"version":"moon","text":"It’s tough enough to run right through the night, and it’s also a hard worker, but it’s still just a youngster."},{"version":"ultra-sun","text":"It knows how people and Pokémon feel by looking at their auras. It doesn’t approach dangerous opponents."},{"version":"ultra-moon","text":"It uses waves called auras to communicate with others of its kind. It doesn’t make any noise during this time, so its enemies can’t detect it."},{"version":"sword","text":"It’s exceedingly energetic, with enough stamina to keep running all through the night. Taking it for walks can be a challenging experience."},{"version":"shield","text":"It can use waves called auras to gauge how others are feeling. These same waves can also tell this Pokémon about the state of the environment."},{"version":"legends-arceus","text":"Though infantile in appearance, it has the mysterious ability to read the minds of humans. The pure of heart are met with Riolu's approval, while those of ill nature earn only its loathing."}],"genderRate":1,"captureRate":75,"eggGroups":["no-eggs"],"isLegendary":false,"isMythical":false,"evolution":{"species":"riolu","speciesId":447,"evolvesTo":[{"conditions":["Felicidade alta, De dia"],"species":"lucario","speciesId":448,"evolvesTo":[]}]},"varieties":[{"id":447,"name":"riolu","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/447.png"}],"games":[8,9,10,11,14,15,16,17,18,20,23,24,25],"moves":[{"id":5,"learn":[[20,"tm",0]]},{"id":8,"learn":[[9,"tutor",0],[10,"tutor",0],[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":9,"learn":[[9,"tutor",0],[10,"tutor",0],[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":14,"learn":[[8,"tm",0],[9,"tm",0],[10,"tm",0],[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"lv",40],[20,"tm",0],[23,"lv",40],[23,"tm",0],[25,"lv",40],[25,"tm",0]]},{"id":25,"learn":[[20,"tm",0]]},{"id":29,"learn":[[10,"tutor",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":44,"learn":[[8,"egg",0],[9,"egg",0],[10,"egg",0],[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[23,"egg",0],[24,"lv",9],[25,"egg",0]]},{"id":46,"learn":[[8,"tm",0],[9,"tm",0],[10,"tm",0],[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[23,"tm",0]