{"id":566,"name":"archen","speciesId":566,"dex":566,"form":"normal","generation":5,"types":["rock","flying"],"stats":{"hp":55,"attack":112,"defense":45,"special-attack":74,"special-defense":45,"speed":70},"abilities":[{"name":"defeatist","hidden":false}],"height":5,"weight":95,"baseExp":71,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/566.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/566.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/566.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/566.ogg","genus":"First Bird Pokémon","genusPt":"Primeiro Pokémon Pássaro","flavor":[{"version":"black","text":"Said to be an ancestor of bird Pokémon, they were unable to fly and moved about by hopping from one branch to another."},{"version":"white","text":"Revived from a fossil, this Pokémon is thought to be the ancestor of all bird Pokémon."},{"version":"black-2","text":"It was revived from an ancient fossil. Not able to fly, it lived in treetops and hopped from one branch to another."},{"version":"sun","text":"It is the ancestor of all bird Pokémon. Archen itself could not actually fly but moved by hopping from treetop to treetop."},{"version":"moon","text":"To all appearances flightless, it was able to glide down from tall treetops to snag its prey."},{"version":"ultra-sun","text":"Once thought to be the ancestor of all bird Pokémon, some of the latest research suggests that may not be the case."},{"version":"ultra-moon","text":"Restored from a fossil, this ancient bird Pokémon has wings but can’t yet fly."},{"version":"sword","text":"This Pokémon was successfully restored from a fossil. As research suggested, Archen is unable to fly. But it’s very good at jumping."},{"version":"shield","text":"Archen is said to be the ancestor of bird Pokémon. It lived in treetops, eating berries and bug Pokémon."}],"flavorPt":"Diz-se que Archen é o ancestral dos Pokémon pássaros. Ele vivia nas copas das árvores, comendo frutas e insetos Pokémon.","genderRate":1,"captureRate":45,"eggGroups":["flying","water3"],"isLegendary":false,"isMythical":false,"evolution":{"species":"archen","speciesId":566,"evolvesTo":[{"conditions":["Nível 37"],"species":"archeops","speciesId":567,"evolvesTo":[]}]},"varieties":[{"id":566,"name":"archen","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/566.png"}],"games":[11,14,15,16,17,18,20],"moves":[{"id":15,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":17,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",6]]},{"id":37,"learn":[[11,"lv",51],[14,"lv",51],[15,"lv",50],[16,"lv",50],[17,"lv",50],[18,"lv",50],[20,"lv",42]]},{"id":43,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1]]},{"id":44,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0]]},{"id":46,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":88,"learn":[[11,"lv",5],[14,"lv",5],[15,"lv",5],[16,"lv",5],[17,"lv",5],[18,"lv",5],[20,"lv",3]]},{"id":89,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":91,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[20,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":97,"learn":[[11,"lv",21],[14,"lv",21],[15,"lv",21],[16,"lv",21],[17,"lv",21],[18,"lv",21],[20,"lv",33],[20,"tm",0]]},{"id":98,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1]]},{"id":104,"learn":[[11,"lv",8],[11,"tm",0],[14,"lv",8],[14,"tm",0],[15,"lv",8],[15,"tm",0],[16,"lv",8],[16,"tm",0],[17,"lv",8],[17,"tm",0],[18,"lv",8],[18,"tm",0],[20,"egg",0