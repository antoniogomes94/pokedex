{"id":546,"name":"cottonee","speciesId":546,"dex":546,"form":"normal","generation":5,"types":["grass","fairy"],"stats":{"hp":40,"attack":27,"defense":60,"special-attack":37,"special-defense":50,"speed":66},"abilities":[{"name":"prankster","hidden":false},{"name":"infiltrator","hidden":false},{"name":"chlorophyll","hidden":true}],"height":3,"weight":6,"baseExp":56,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/546.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/546.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/546.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/546.ogg","genus":"Cotton Puff Pokémon","flavor":[{"version":"black","text":"When attacked, it escapes by shooting cotton from its body. The cotton serves as a decoy to distract the attacker."},{"version":"white","text":"They go wherever the wind takes them. On rainy days, their bodies are heavier, so they take shelter beneath big trees."},{"version":"black-2","text":"Perhaps because they feel more at ease in a group, they stick to others they find. They end up looking like a cloud."},{"version":"sun","text":"When it finds others of its kind, they all stick together. When enough of them have collected, the mass resembles a cumulonimbus cloud."},{"version":"moon","text":"Pillows and beds stuffed with cotton exhaled by Cottonee are soft and puffy, light and airy— altogether top quality."},{"version":"ultra-sun","text":"To protect itself, it shoots cotton from its body. When it gets wet in the rain, its cotton grows moist and heavy, and it can’t move as well."},{"version":"ultra-moon","text":"When attacked, it expels cotton from its body to create a diversion. The cotton it loses grows back in quickly."},{"version":"sword","text":"It shoots cotton from its body to protect itself. If it gets caught up in hurricane-strength winds, it can get sent to the other side of the Earth."},{"version":"shield","text":"Weaving together the cotton of both Cottonee and Eldegoss produces exquisite cloth that’s highly prized by many luxury brands."}],"genderRate":4,"captureRate":190,"eggGroups":["plant","fairy"],"isLegendary":false,"isMythical":false,"evolution":{"species":"cottonee","speciesId":546,"evolvesTo":[{"conditions":["Usar Sun Stone"],"species":"whimsicott","speciesId":547,"evolvesTo":[]}]},"varieties":[{"id":546,"name":"cottonee","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/546.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":71,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":72,"learn":[[11,"lv",13],[14,"lv",13],[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13],[20,"lv",12],[25,"lv",12]]},{"id":73,"learn":[[11,"lv",8],[14,"lv",8],[15,"lv",8],[16,"lv",8],[17,"lv",8],[18,"lv",8],[20,"lv",30],[25,"lv",30]]},{"id":74,"learn":[[11,"lv",4],[14,"lv",4],[15,"lv",4],[16,"lv",4],[17,"lv",4],[18,"lv",4],[20,"lv",18],[25,"lv",18]]},{"id":75,"learn":[[11,"lv",19],[14,"lv",19],[15,"lv",19],[16,"lv",19],[17,"lv",19],[18,"lv",19],[20,"lv",15],[25,"lv",15]]},{"id":76,"learn":[[11,"lv",46],[11,"tm",0],[14,"lv",46],[14,"tm",0],[15,"lv",46],[15,"tm",0],[16,"lv",46],[16,"tm",0],[17,"lv",46],[17,"tm",0],[18,"lv",46],[18,"tm",0],[20,"lv",48],[20,"tm",0],[25,"lv",48],[25,"tm",0]]},{"id":77,"learn":[[11,"lv",22],[14,"lv",22],[15,"lv",22],[16,"lv",22],[17,"lv",22],[18,"lv",22],[20,"lv",21],[25,"lv",21]]},{"id":78,"learn":[[11,"lv",10],[14,"lv",10],[15,"lv",10],[16,"lv",10],[17,"lv",10],[18,"lv",10],[20,"lv",6],[25,"lv",6]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":129,"learn":[[20,"tm",0],[25,"tm",