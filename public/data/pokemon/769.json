{"id":769,"name":"sandygast","speciesId":769,"dex":769,"form":"normal","generation":7,"types":["ghost","ground"],"stats":{"hp":55,"attack":55,"defense":80,"special-attack":70,"special-defense":45,"speed":15},"abilities":[{"name":"water-compaction","hidden":false},{"name":"sand-veil","hidden":true}],"height":5,"weight":700,"baseExp":64,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/769.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/769.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/769.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/769.ogg","genus":"Sand Heap Pokémon","flavor":[{"version":"sun","text":"Born from a sand mound playfully built by a child, this Pokémon embodies the grudges of the departed."},{"version":"moon","text":"It takes control of anyone who puts a hand in its mouth. And so it adds to the accumulation of its sand-mound body."},{"version":"ultra-sun","text":"It likes the shovel on its head, so Sandygast will get serious and fight any children who come to take it back."},{"version":"ultra-moon","text":"If you build sand mounds when you’re playing, destroy them before you go home, or they may get possessed and become Sandygast."},{"version":"sword","text":"Grudges of the dead have possessed a mound of sand and become a Pokémon. Sandygast is fond of the shovel on its head."},{"version":"shield","text":"Sandygast mainly inhabits beaches. It takes control of anyone who puts their hand into its mouth, forcing them to make its body bigger."}],"genderRate":4,"captureRate":140,"eggGroups":["indeterminate"],"isLegendary":false,"isMythical":false,"evolution":{"species":"sandygast","speciesId":769,"evolvesTo":[{"conditions":["Nível 42"],"species":"palossand","speciesId":770,"evolvesTo":[]}]},"varieties":[{"id":769,"name":"sandygast","form":"normal