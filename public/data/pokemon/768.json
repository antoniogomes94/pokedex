{"id":768,"name":"golisopod","speciesId":768,"dex":768,"form":"normal","generation":7,"types":["bug","water"],"stats":{"hp":75,"attack":125,"defense":140,"special-attack":60,"special-defense":90,"speed":40},"abilities":[{"name":"emergency-exit","hidden":false}],"height":20,"weight":1080,"baseExp":186,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/768.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/768.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/768.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/768.ogg","genus":"Hard Scale Pokémon","flavor":[{"version":"sun","text":"With a flashing slash of its giant sharp claws, it cleaves seawater—or even air—right in two."},{"version":"moon","text":"It battles skillfully with its six arms, but spends most of its time peacefully meditating in caves deep beneath the sea."},{"version":"ultra-sun","text":"The shell covering its body is as hard as diamond. This Pokémon will do anything it takes to win."},{"version":"ultra-moon","text":"Its claws, which it can extend and retract at will, are its greatest weapons. Golisopod is sometimes accompanied by Wimpod."},{"version":"sword","text":"It will do anything to win, taking advantage of every opening and finishing opponents off with the small claws on its front legs."},{"version":"shield","text":"They live in sunken ships or in holes in the seabed. When Golisopod and Grapploct battle, the loser becomes the winner’s meal."}],"genderRate":4,"captureRate":45,"eggGroups":["bug","water3"],"isLegendary":false,"isMythical":false,"evolution":{"species":"wimpod","speciesId":767,"evolvesTo":[{"conditions":["Nível 30"],"species":"golisopod","speciesId":768,"evolvesTo":[]}]},"varieties":[{"id":768,"name":"golisopod","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/s