{"id":597,"name":"ferroseed","speciesId":597,"dex":597,"form":"normal","generation":5,"types":["grass","steel"],"stats":{"hp":44,"attack":50,"defense":91,"special-attack":24,"special-defense":86,"speed":10},"abilities":[{"name":"iron-barbs","hidden":false}],"height":6,"weight":188,"baseExp":61,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/597.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/597.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/597.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/597.ogg","genus":"Thorn Seed Pokémon","genusPt":"Pokémon Semente de Espinho","flavor":[{"version":"black","text":"When threatened, it attacks by shooting a barrage of spikes, which gives it a chance to escape by rolling away."},{"version":"white","text":"They stick their spikes into cave walls and absorb the minerals they find in the rock."},{"version":"black-2","text":"It absorbs the iron it finds in the rock while clinging to the ceiling. It shoots spikes when in danger."},{"version":"sword","text":"It defends itself by launching spikes, but its aim isn’t very good at first. Only after a lot of practice will it improve."},{"version":"shield","text":"Mossy caves are their preferred dwellings. Enzymes contained in mosses help Ferroseed’s spikes grow big and strong."}],"flavorPt":"Cavernas cobertas de musgo são suas habitações preferidas. As enzimas contidas nos musgos ajudam os espinhos do Ferroseed a crescerem grandes e fortes.","genderRate":4,"captureRate":255,"eggGroups":["plant","mineral"],"isLegendary":false,"isMythical":false,"evolution":{"species":"ferroseed","speciesId":597,"evolvesTo":[{"conditions":["Nível 40"],"species":"ferrothorn","speciesId":598,"evolvesTo":[]}]},"varieties":[{"id":597,"name":"ferroseed","form":"normal","sprite":"https://raw.githubuserc