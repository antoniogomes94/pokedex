{"id":704,"name":"goomy","speciesId":704,"dex":704,"form":"normal","generation":6,"types":["dragon"],"stats":{"hp":45,"attack":50,"defense":35,"special-attack":55,"special-defense":75,"speed":40},"abilities":[{"name":"sap-sipper","hidden":false},{"name":"hydration","hidden":false},{"name":"gooey","hidden":true}],"height":3,"weight":28,"baseExp":60,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/704.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/704.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/704.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/704.ogg","genus":"Soft Tissue Pokémon","flavor":[{"version":"x","text":"The weakest Dragon-type Pokémon, it lives in damp, shady places, so its body doesn’t dry out."},{"version":"y","text":"It’s covered in a slimy membrane that makes any punches or kicks slide off it harmlessly."},{"version":"sun","text":"The weakest of all Dragon-type Pokémon, it’s unable to breathe if its skin dries out, so it sticks to shady places."},{"version":"moon","text":"Its source of protection is its slimy, germ-laden mucous membrane. Anyone who touches it needs some thorough hand-washing."},{"version":"ultra-sun","text":"It uses its horns to check out its surroundings. They’re very sensitive, so if you grab them, it will feel a strong shock and be unable to move."},{"version":"ultra-moon","text":"Its body is mostly water. If it dries out, it will die, so it’s always sitting with perfect stillness in the shade."},{"version":"sword","text":"Because most of its body is water, it will dry up if the weather becomes too arid. It’s considered the weakest dragon Pokémon."},{"version":"shield","text":"Their horns are powerful sensors. As soon as Goomy pick up any sign of enemies, they go into hiding. This is how they’ve survived."},{"version":"legends-arceus","text":"Goomy hides away in the shade of trees, where it's nice and humid. If the slime coating its body dries out, the Pokémon instantly becomes lethargic."}],"genderRate":4,"captureRate":45,"eggGroups":["dragon"],"isLegendary":false,"isMythical":false,"evolution":{"species":"goomy","speciesId":704,"evolvesTo":[{"conditions":["Nível 40","Nível 40"],"species":"sliggoo","speciesId":705,"evolvesTo":[{"conditions":["Nível 50, Chovendo","Nível 50, Chovendo"],"species":"goodra","speciesId":706,"evolvesTo":[]}]}]},"varieties":[{"id":704,"name":"goomy","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/704.png"}],"games":[15,16,17,18,20,24,25],"moves":[{"id":33,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":34,"learn":[[15,"lv",32],[16,"lv",32],[17,"lv",32],[18,"lv",32],[20,"lv",45],[20,"tm",0],[25,"lv",45],[25,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":55,"learn":[[20,"lv",5],[25,"lv",5]]},{"id":56,"learn":[[24,"lv",43]]},{"id":68,"learn":[[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[25,"egg",0]]},{"id":71,"learn":[[15,"lv",5],[16,"lv",5],[17,"lv",5],[18,"lv",5],[20,"lv",1],[25,"lv",1]]},{"id":85,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":117,"learn":[[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13]]},{"id":145,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[24,"lv",1]]},{"id":151,"learn":[[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[24,"lv",11]]},{"id":156,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":157,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":164,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0