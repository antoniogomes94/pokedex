{"id":749,"name":"mudbray","speciesId":749,"dex":749,"form":"normal","generation":7,"types":["ground"],"stats":{"hp":70,"attack":100,"defense":70,"special-attack":45,"special-defense":55,"speed":45},"abilities":[{"name":"own-tempo","hidden":false},{"name":"stamina","hidden":false},{"name":"inner-focus","hidden":true}],"height":10,"weight":1100,"baseExp":77,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/749.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/749.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/749.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/749.ogg","genus":"Donkey Pokémon","flavor":[{"version":"sun","text":"The mud stuck to Mudbray’s hooves enhances its grip and its powerful running gait."},{"version":"moon","text":"It has a stubborn, individualistic disposition. Eating dirt, making mud, and playing in the mire all form part of its daily routine."},{"version":"ultra-sun","text":"It loves playing in the mud. If it isn’t showered with mud on a daily basis, it gets stressed out and stops listening to its Trainer."},{"version":"ultra-moon","text":"Possessing mighty power, Mudbray can be loaded with 50 times its own body weight and will be totally fine."},{"version":"sword","text":"Loads weighing up to 50 times as much as its own body weight pose no issue for this Pokémon. It’s skilled at making use of mud."},{"version":"shield","text":"It eats dirt to create mud and smears this mud all over its feet, giving them the grip needed to walk on rough terrain without slipping."}],"genderRate":4,"captureRate":190,"eggGroups":["ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"mudbray","speciesId":749,"evolvesTo":[{"conditions":["Nível 30"],"species":"mudsdale","speciesId":750,"evolvesTo":[]}]},"varieties":[{"id":749,"name":"mudbr