{"id":751,"name":"dewpider","speciesId":751,"dex":751,"form":"normal","generation":7,"types":["water","bug"],"stats":{"hp":38,"attack":40,"defense":52,"special-attack":40,"special-defense":72,"speed":27},"abilities":[{"name":"water-bubble","hidden":false},{"name":"water-absorb","hidden":true}],"height":3,"weight":40,"baseExp":54,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/751.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/751.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/751.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/751.ogg","genus":"Water Bubble Pokémon","flavor":[{"version":"sun","text":"It crawls onto the land in search of food. Its water bubble allows it to breathe and protects its soft head."},{"version":"moon","text":"When it comes across enemies or potential prey, this Pokémon smashes its water-bubble-covered head into them."},{"version":"ultra-sun","text":"When two Dewpider meet, they display their water bubbles to each other. Then the one with the smaller bubble gets out of the other’s way."},{"version":"ultra-moon","text":"It can only breathe oxygen that has dissolved in water, so it wears a water bubble on its head when it walks around on land."},{"version":"sword","text":"It forms a water bubble at the rear of its body and then covers its head with it. Meeting another Dewpider means comparing water-bubble sizes."},{"version":"shield","text":"Dewpider normally lives underwater. When it comes onto land in search of food, it takes water with it in the form of a bubble on its head."}],"genderRate":4,"captureRate":200,"eggGroups":["water1","bug"],"isLegendary":false,"isMythical":false,"evolution":{"species":"dewpider","speciesId":751,"evolvesTo":[{"conditions":["Nível 22"],"species":"araquanid","speciesId":752,"evolvesTo":[]}]},"varieti