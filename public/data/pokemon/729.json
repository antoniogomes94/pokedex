{"id":729,"name":"brionne","speciesId":729,"dex":729,"form":"normal","generation":7,"types":["water"],"stats":{"hp":60,"attack":69,"defense":69,"special-attack":91,"special-defense":81,"speed":50},"abilities":[{"name":"torrent","hidden":false},{"name":"liquid-voice","hidden":true}],"height":6,"weight":175,"baseExp":147,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/729.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/729.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/729.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/729.ogg","genus":"Pop Star Pokémon","flavor":[{"version":"sun","text":"A skillful dancer, it creates a sequence of water balloons as it dances, and briskly bombards its enemies."},{"version":"moon","text":"It cares deeply for its companions. When its Trainer is feeling down, it performs a cheery dance to try and help."},{"version":"ultra-sun","text":"It gets excited when it sees a dance it doesn’t know. This hard worker practices diligently until it can learn that dance."},{"version":"ultra-moon","text":"It attacks by smacking its enemies with the exploding water balloons that it creates."},{"version":"sword","text":"As if dancing, it artfully dodges the attacks of its enemies. All the while, it’s busy forming a bunch of balloons to overwhelm its foes."},{"version":"shield","text":"On nights when the sea is calm, Brionne dance with one another to the singing of the Primarina that’s leading them."}],"genderRate":1,"captureRate":45,"eggGroups":["water1","ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"popplio","speciesId":728,"evolvesTo":[{"conditions":["Nível 17"],"species":"brionne","speciesId":729,"evolvesTo":[{"conditions":["Nível 34"],"species":"primarina","speciesId":730,"evolvesTo":[]}]}]},"varieties":[{"id":729,