{"id":524,"name":"roggenrola","speciesId":524,"dex":524,"form":"normal","generation":5,"types":["rock"],"stats":{"hp":55,"attack":75,"defense":85,"special-attack":25,"special-defense":25,"speed":15},"abilities":[{"name":"sturdy","hidden":false},{"name":"weak-armor","hidden":false},{"name":"sand-force","hidden":true}],"height":4,"weight":180,"baseExp":56,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/524.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/524.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/524.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/524.ogg","genus":"Mantle Pokémon","genusPt":"Pokémon de manto","flavor":[{"version":"black","text":"Its ear is hexagonal in shape. Compressed underground, its body is as hard as steel."},{"version":"white","text":"They were discovered a hundred years ago in an earthquake fissure. Inside each one is an energy core."},{"version":"black-2","text":"The hexagonal-shaped hole is its ear. It has a tendency to walk in the direction the sound is coming from."},{"version":"sun","text":"Born deep within the ground, it compares itself with similar species, such as Geodude and Carbink, to settle which has the hardest body."},{"version":"moon","text":"The hexagonal cavity is its ear. It walks in the direction of sounds it hears, but if the sounds cease, it panics and topples over."},{"version":"ultra-sun","text":"The hexagonal hole is its ear. Deep in that ear is an energy core, so if you stick your hand in there, Roggenrola will be very angry!"},{"version":"ultra-moon","text":"It was found in a fissure in a layer of exposed rock. The material that makes up its body is dirt from several hundred years ago."},{"version":"sword","text":"It’s as hard as steel, but apparently a long soak in water will cause it to soften a bit."},{"version":"shield","text":"When it detects a noise, it starts to move. The energy core inside it makes this Pokémon slightly warm to the touch."}],"flavorPt":"Ao detectar um ruído, ele começa a se mover. O núcleo de energia dentro dele torna este Pokémon ligeiramente quente ao toque.","genderRate":4,"captureRate":255,"eggGroups":["mineral"],"isLegendary":false,"isMythical":false,"evolution":{"species":"roggenrola","speciesId":524,"evolvesTo":[{"conditions":["Nível 25"],"species":"boldore","speciesId":525,"evolvesTo":[{"conditions":["Troca"],"species":"gigalith","speciesId":526,"evolvesTo":[]}]}]},"varieties":[{"id":524,"name":"roggenrola","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/524.png"}],"games":[11,14,15,16,17,18,20],"moves":[{"id":28,"learn":[[11,"lv",7],[14,"lv",7],[15,"lv",7],[16,"lv",7],[17,"lv",7],[18,"lv",7],[20,"lv",1]]},{"id":29,"learn":[[11,"lv",10],[14,"lv",10],[15,"lv",10],[16,"lv",10],[17,"lv",10],[18,"lv",10],[20,"lv",24]]},{"id":33,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1]]},{"id":36,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0]]},{"id":70,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":89,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":106,"learn":[[11,"lv",4],[14,"lv",4],[15,"lv",4],[16,"lv",4],[17,"lv",4],[18,"lv",4],[20,"lv",4]]},{"id":153,"learn":[[11,"lv",40],[11,"tm",0],[14,"lv",40],[14,"tm",0],[15,"lv",40],[15,"tm",0],[16,"lv",40],[16,"tm",0],[17,"lv",40],[17,"tm",0],[18,"lv",40],[18,"tm",0],[20,"lv",44]]},{"id":156,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm"