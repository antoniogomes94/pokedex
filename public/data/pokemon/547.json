{"id":547,"name":"whimsicott","speciesId":547,"dex":547,"form":"normal","generation":5,"types":["grass","fairy"],"stats":{"hp":60,"attack":67,"defense":85,"special-attack":77,"special-defense":75,"speed":116},"abilities":[{"name":"prankster","hidden":false},{"name":"infiltrator","hidden":false},{"name":"chlorophyll","hidden":true}],"height":7,"weight":66,"baseExp":168,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/547.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/547.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/547.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/547.ogg","genus":"Windveiled Pokémon","genusPt":"Pokémon Velado pelo Vento","flavor":[{"version":"black","text":"Like the wind, it can slip through any gap, no matter how small. It leaves balls of white fluff behind."},{"version":"white","text":"Riding whirlwinds, they appear. These Pokémon sneak through gaps into houses and cause all sorts of mischief."},{"version":"black-2","text":"They appear along with whirlwinds. They pull pranks, such as moving furniture and leaving balls of cotton in homes."},{"version":"sun","text":"It rides on the wind and slips into people’s homes. After it has turned a room into a cotton- filled mess, it giggles to itself and takes off."},{"version":"moon","text":"This Pokémon appears, riding upon the wind. But if the wind gusts up, it’ll blow the cotton on this Pokémon’s head clean off."},{"version":"ultra-sun","text":"This nuisance sneaks into people’s homes, where it hides important things and scatters cotton all over the place."},{"version":"ultra-moon","text":"Whimsicott doesn’t live in a fixed location. It floats around on whirling winds, appearing all over the place to perform its mischief."},{"version":"sword","text":"It scatters cotton all over the place as a prank. If it gets wet, it’ll become too heavy to move and have no choice but to answer for its mischief."},{"version":"shield","text":"As long as this Pokémon bathes in sunlight, its cotton keeps growing. If too much cotton fluff builds up, Whimsicott tears it off and scatters it."}],"flavorPt":"Enquanto este Pokémon tomar banho de luz solar, seu algodão continuará crescendo. Se acumular muita penugem de algodão, Whimsicott arranca-a e espalha-a.","genderRate":4,"captureRate":75,"eggGroups":["plant","fairy"],"isLegendary":false,"isMythical":false,"evolution":{"species":"cottonee","speciesId":546,"evolvesTo":[{"conditions":["Usar Sun Stone"],"species":"whimsicott","speciesId":547,"evolvesTo":[]}]},"varieties":[{"id":547,"name":"whimsicott","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/547.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":16,"learn":[[11,"lv",10],[14,"lv",10],[15,"lv",10],[16,"lv",10],[17,"lv",10],[18,"lv",10],[20,"lv",1],[25,"lv",1]]},{"id":63,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":71,"learn":[[20,"lv",1],[25,"lv",1]]},{"id":72,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":73,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":74,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":75,"learn":[[20,"lv",1],[25,"lv",1]]},{"id":76,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"lv",1],[20,"tm",0],[25,"lv",1],[25,"tm",0]]},{"id":77,"learn":[[20,"lv",1],[25,"lv",1]]},{"id":78,"learn":[[20,"lv",1],[25,"lv",1]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":94,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0]