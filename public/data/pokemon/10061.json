{"id":10061,"name":"floette-eternal","speciesId":670,"dex":670,"form":"other","generation":6,"types":["fairy"],"stats":{"hp":74,"attack":65,"defense":67,"special-attack":125,"special-defense":128,"speed":92},"abilities":[{"name":"flower-veil","hidden":false},{"name":"symbiosis","hidden":true}],"height":2,"weight":9,"baseExp":243,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10061.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/10061.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/10061.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/10061.ogg","genus":"Single Bloom Pokémon","flavor":[{"version":"x","text":"It flutters around fields of flowers and cares for flowers that are starting to wilt. It draws out the hidden power of flowers to battle."},{"version":"y","text":"When the flowers of a well-tended flower bed bloom, it appears and celebrates with an elegant dance."},{"version":"ultra-sun","text":"It raises flowers and uses them as weapons. The more gorgeous the blossom, the more power it contains."},{"version":"ultra-moon","text":"It gives its own power to flowers, pouring its heart into caring for them. Floette never forgives anyone who messes up a flower bed."}],"genderRate":8,"captureRate":120,"eggGroups":["fairy"],"isLegendary":false,"isMythical":false,"evolution":{"species":"flabebe","speciesId":669,"evolvesTo":[{"conditions":["Nível 19"],"species":"floette","speciesId":670,"evolvesTo":[{"conditions":["Usar Shiny Stone"],"species":"florges","speciesId":671,"evolvesTo":[]}]}]},"varieties":[{"id":670,"name":"floette","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/670.png"},{"id":10061,"name":"floette-eternal","form":"other","sprite":"https://raw.githubusercontent.com/PokeAPI/s