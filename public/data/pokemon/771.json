{"id":771,"name":"pyukumuku","speciesId":771,"dex":771,"form":"normal","generation":7,"types":["water"],"stats":{"hp":55,"attack":60,"defense":130,"special-attack":30,"special-defense":130,"speed":5},"abilities":[{"name":"innards-out","hidden":false},{"name":"unaware","hidden":true}],"height":3,"weight":12,"baseExp":144,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/771.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/771.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/771.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/771.ogg","genus":"Sea Cucumber Pokémon","flavor":[{"version":"shield","text":"It’s covered in a slime that keeps its skin moist, allowing it to stay on land for days without drying up."},{"version":"sun","text":"It lives in shallow seas, such as areas near a beach. It can eject its internal organs, which it uses to engulf its prey or battle enemies."},{"version":"moon","text":"These Pokémon line the beaches. The sticky mucous that covers their bodies can be used to soothe sunburned skin. How convenient!"},{"version":"ultra-sun","text":"The tradition known as Pyukumuku chucking started from the custom of throwing Pyukumuku back into the sea after they wash onshore."},{"version":"ultra-moon","text":"Its entire body is covered in its own slime. If you accidentally step on one, you’ll slip, and it will get mad and smack you!"},{"version":"sword","text":"It lives in warm, shallow waters. If it encounters a foe, it will spit out its internal organs as a means to punch them."}],"genderRate":4,"captureRate":60,"eggGroups":["water1"],"isLegendary":false,"isMythical":false,"evolution":{"species":"pyukumuku","speciesId":771,"evolvesTo":[]},"varieties":[{"id":771,"name":"pyukumuku","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/spr