{"id":783,"name":"hakamo-o","speciesId":783,"dex":783,"form":"normal","generation":7,"types":["dragon","fighting"],"stats":{"hp":55,"attack":75,"defense":90,"special-attack":65,"special-defense":70,"speed":65},"abilities":[{"name":"bulletproof","hidden":false},{"name":"soundproof","hidden":false},{"name":"overcoat","hidden":true}],"height":12,"weight":470,"baseExp":147,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/783.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/783.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/783.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/783.ogg","genus":"Scaly Pokémon","flavor":[{"version":"sun","text":"It leaps at its prey with a courageous shout. Its scaly punches tear its opponents to shreds."},{"version":"moon","text":"It sheds and regrows its scales on a continuous basis. The scales become harder and sharper each time they’re regrown."},{"version":"ultra-sun","text":"It makes noise by clanging its scales together. When the rhythm has reached its peak, Hakamo-o attacks."},{"version":"ultra-moon","text":"The scales it sheds can be molded and processed to make pots and pans. They conduct heat well, so they’re a popular item."},{"version":"sword","text":"The scaleless, scarred parts of its body are signs of its strength. It shows them off to defeated opponents."},{"version":"shield","text":"Before attacking its enemies, it clashes its scales together and roars. Its sharp claws shred the opposition."}],"genderRate":4,"captureRate":45,"eggGroups":["dragon"],"isLegendary":false,"isMythical":false,"evolution":{"species":"jangmo-o","speciesId":782,"evolvesTo":[{"conditions":["Nível 35"],"species":"hakamo-o","speciesId":783,"evolvesTo":[{"conditions":["Nível 45"],"species":"kommo-o","speciesId":784,"evolvesTo":[]}]}]},"varieties