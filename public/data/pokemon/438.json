{"id":438,"name":"bonsly","speciesId":438,"dex":438,"form":"normal","generation":4,"types":["rock"],"stats":{"hp":50,"attack":80,"defense":95,"special-attack":10,"special-defense":45,"speed":10},"abilities":[{"name":"sturdy","hidden":false},{"name":"rock-head","hidden":false},{"name":"rattled","hidden":true}],"height":5,"weight":150,"baseExp":58,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/438.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/438.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/438.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/438.ogg","genus":"Bonsai Pokémon","flavor":[{"version":"diamond","text":"It looks as if it is always crying. It is actually adjusting its body’s fluid levels by eliminating excess."},{"version":"pearl","text":"It prefers arid environments. It leaks water from its eyes to adjust its body’s fluid levels."},{"version":"platinum","text":"It prefers an arid atmosphere. It leaks water that looks like tears when adjusting its moisture level."},{"version":"heartgold","text":"In order to adjust the level of fluids in its body, it exudes water from its eyes. This makes it appear to be crying."},{"version":"sun","text":"It does not deal well with water, so it lives in dry locales. Since its surroundings tend to lack greenery, it stands out noticeably."},{"version":"moon","text":"From its eyes, it can expel excess moisture from its body. This liquid is similar in composition to human sweat."},{"version":"ultra-sun","text":"It discharges moisture from its eyes, making it look like it’s crying—apparently an effective way of getting enemies to let down their guard."},{"version":"ultra-moon","text":"If its body gets too damp, it will die. So, in a process reminiscent of sweating, its eyes expel moisture."},{"version":"sword","text":"It expels both sweat and tears from its eyes. The sweat is a little salty, while the tears have a slight bitterness."},{"version":"shield","text":"This Pokémon lives in dry, rocky areas. As its green spheres dry out, their dull luster increases."},{"version":"legends-arceus","text":"Its tears elicit sympathy from those who see them, but do not be deceived! This expulsion of body water is merely a physiological mechanism for keeping itself in good health."}],"genderRate":4,"captureRate":255,"eggGroups":["no-eggs"],"isLegendary":false,"isMythical":false,"evolution":{"species":"bonsly","speciesId":438,"evolvesTo":[{"conditions":["Sabendo Mimic"],"species":"sudowoodo","speciesId":185,"evolvesTo":[]}]},"varieties":[{"id":438,"name":"bonsly","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/438.png"}],"games":[8,9,10,11,14,15,16,17,18,20,23,24,25],"moves":[{"id":21,"learn":[[8,"lv",38],[9,"lv",38],[10,"lv",38],[11,"lv",38],[14,"lv",15]]},{"id":29,"learn":[[8,"egg",0],[9,"egg",0],[10,"egg",0],[10,"tutor",0],[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[23,"egg",0],[25,"egg",0]]},{"id":33,"learn":[[24,"lv",5]]},{"id":34,"learn":[[25,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":38,"learn":[[8,"lv",46],[9,"lv",46],[10,"lv",46],[11,"lv",46],[14,"lv",40],[15,"lv",40],[16,"lv",40],[17,"lv",43],[18,"lv",43],[20,"lv",44],[23,"lv",44],[24,"lv",37],[25,"lv",44],[25,"tm",0]]},{"id":67,"learn":[[8,"lv",9],[9,"lv",9],[10,"lv",9],[10,"tutor",0],[11,"lv",9],[14,"lv",8],[14,"tutor",0],[15,"lv",8],[16,"lv",8],[16,"tutor",0],[17,"lv",8],[18,"lv",8],[18,"tutor",0],[20,"lv",36],[20,"tm",0],[23,"lv",36],[25,"lv",36],[25,"tm",0]]},{"id":68,"learn":[[15,"lv",33],[16,"lv",33],[17,"lv",36],[18,"lv",36],[20,"lv",40],[23,"lv",40],[25,"lv",40]]},{"id":88,"learn":[[8,"lv",14],[9,"lv",14],[10,"lv",14],[11,"lv",14],[14,"lv",12],[15,"lv",12],[16,"lv",12],[17,"lv",12],[18,"lv",12],[2