{"id":554,"name":"darumaka","speciesId":554,"dex":554,"form":"normal","generation":5,"types":["fire"],"stats":{"hp":70,"attack":90,"defense":45,"special-attack":15,"special-defense":45,"speed":50},"abilities":[{"name":"hustle","hidden":false},{"name":"inner-focus","hidden":true}],"height":6,"weight":375,"baseExp":63,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/554.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/554.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/554.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/554.ogg","genus":"Zen Charm Pokémon","flavor":[{"version":"black","text":"When its internal fire is burning, it cannot calm down and it runs around. When the fire diminishes, it falls asleep."},{"version":"white","text":"Darumaka’s droppings are hot, so people used to put them in their clothes to keep themselves warm."},{"version":"black-2","text":"When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100° F."},{"version":"y","text":"When it sleeps, it pulls its limbs into its body and its internal fire goes down to 1,100 degrees Fahrenheit."},{"version":"sword","text":"It derives its power from fire burning inside its body. If the fire dwindles, this Pokémon will immediately fall asleep."},{"version":"shield","text":"This popular symbol of good fortune will never fall over in its sleep, no matter how it’s pushed or pulled."}],"genderRate":4,"captureRate":120,"eggGroups":["ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"darumaka","speciesId":554,"evolvesTo":[{"conditions":["Nível 35","Usar Ice Stone"],"species":"darmanitan","speciesId":555,"evolvesTo":[]}]},"varieties":[{"id":554,"name":"darumaka","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/po