{"id":739,"name":"crabrawler","speciesId":739,"dex":739,"form":"normal","generation":7,"types":["fighting"],"stats":{"hp":47,"attack":82,"defense":57,"special-attack":42,"special-defense":47,"speed":63},"abilities":[{"name":"hyper-cutter","hidden":false},{"name":"iron-fist","hidden":false},{"name":"anger-point","hidden":true}],"height":6,"weight":70,"baseExp":68,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/739.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/739.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/739.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/739.ogg","genus":"Boxing Pokémon","flavor":[{"version":"sun","text":"While guarding its weak points with its pincers, it looks for an opening and unleashes punches. When it loses, it foams at the mouth and faints."},{"version":"moon","text":"It punches so much, its pincers often come off from overuse, but they grow back quickly. What little meat they contain is rich and delicious."},{"version":"ultra-sun","text":"Its hard pincers are well suited to both offense and defense. Fights between two Crabrawler are like boxing matches."},{"version":"ultra-moon","text":"Crabrawler has been known to mistake Exeggutor for a coconut tree and climb it. The enraged Exeggutor shakes it off and stomps it."}],"genderRate":4,"captureRate":225,"eggGroups":["water3"],"isLegendary":false,"isMythical":false,"evolution":{"species":"crabrawler","speciesId":739,"evolvesTo":[{"conditions":["Em Mount Lanakila","Usar Ice Stone"],"species":"crabominable","speciesId":740,"evolvesTo":[]}]},"varieties":[{"id":739,"name":"crabrawler","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/739.png"}],"games":[17,18,25],"moves":[{"id":8,"learn":[[18,"tutor",0],[25,"tm