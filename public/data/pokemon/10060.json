{"id":10060,"name":"abomasnow-mega","speciesId":460,"dex":460,"form":"mega","generation":4,"types":["grass","ice"],"stats":{"hp":90,"attack":132,"defense":105,"special-attack":132,"special-defense":105,"speed":30},"abilities":[{"name":"snow-warning","hidden":false}],"height":27,"weight":1850,"baseExp":208,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10060.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/10060.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/10060.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/10060.ogg","genus":"Frost Tree Pokémon","flavor":[{"version":"diamond","text":"It whips up blizzards in mountains that are always buried in snow. It is the abominable snowman."},{"version":"pearl","text":"It blankets wide areas in snow by whipping up blizzards. It is also known as “The Ice Monster.”"},{"version":"platinum","text":"They appear when the snow flowers bloom. When the petals fall, they retreat to places unknown again."},{"version":"heartgold","text":"It lives a quiet life on mountains that are perpetually covered in snow. It hides itself by whipping up blizzards."},{"version":"sword","text":"If it sees any packs of Darumaka going after Snover, it chases them off, swinging its sizable arms like hammers."},{"version":"shield","text":"This Pokémon is known to bring blizzards. A shake of its massive body is enough to cause whiteout conditions."},{"version":"legends-arceus","text":"A powerful Pokémon that can split huge boulders with ease. Dislikes associating with others and chooses to live quietly deep within the mountains, playing with the snow."}],"genderRate":4,"captureRate":60,"eggGroups":["monster","plant"],"isLegendary":false,"isMythical":false,"evolution":{"species":"snover","speciesId":459,"evolvesTo":[{"conditions":["Nível 40"],"sp