{"id":764,"name":"comfey","speciesId":764,"dex":764,"form":"normal","generation":7,"types":["fairy"],"stats":{"hp":51,"attack":52,"defense":90,"special-attack":82,"special-defense":110,"speed":100},"abilities":[{"name":"flower-veil","hidden":false},{"name":"triage","hidden":false},{"name":"natural-cure","hidden":true}],"height":1,"weight":3,"baseExp":170,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/764.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/764.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/764.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/764.ogg","genus":"Posy Picker Pokémon","flavor":[{"version":"sun","text":"It attaches flowers to its highly nutritious vine. This revitalizes the flowers, and they give off an aromatic scent."},{"version":"moon","text":"Baths prepared with the flowers from its vine have a relaxing effect, so this Pokémon is a hit with many people."},{"version":"ultra-sun","text":"It stretches sticky vines out from its head and picks flowers to adorn itself with. When it doesn’t have any flowers, it feels uneasy."},{"version":"ultra-moon","text":"It picks flowers and sticks them to its body with fluids it produces. The aroma that wafts from its petals has a healing effect."},{"version":"sword","text":"Comfey picks flowers with its vine and decorates itself with them. For some reason, flowers won’t wither once they’re attached to a Comfey."},{"version":"shield","text":"These Pokémon smell very nice. All Comfey wear different flowers, so each of these Pokémon has its own individual scent."}],"genderRate":6,"captureRate":60,"eggGroups":["plant"],"isLegendary":false,"isMythical":false,"evolution":{"species":"comfey","speciesId":764,"evolvesTo":[]},"varieties":[{"id":764,"name":"comfey","form":"normal","sprite":"https://raw.gith