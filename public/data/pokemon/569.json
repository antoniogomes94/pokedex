{"id":569,"name":"garbodor","speciesId":569,"dex":569,"form":"normal","generation":5,"types":["poison"],"stats":{"hp":80,"attack":95,"defense":82,"special-attack":60,"special-defense":82,"speed":75},"abilities":[{"name":"stench","hidden":false},{"name":"weak-armor","hidden":false},{"name":"aftermath","hidden":true}],"height":19,"weight":1073,"baseExp":166,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/569.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/569.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/569.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/569.ogg","genus":"Trash Heap Pokémon","flavor":[{"version":"black","text":"It clenches opponents with its left arm and finishes them off with foul-smelling poison gas belched from its mouth."},{"version":"white","text":"They absorb garbage and make it part of their bodies. They shoot a poisonous liquid from their right-hand fingertips."},{"version":"black-2","text":"Consuming garbage makes new kinds of poison gases and liquids inside their bodies."},{"version":"sun","text":"Beware the poisonous liquid it shoots from its right arm. If even a little of it gets on you, you’ll experience the effects of the unidentified toxin."},{"version":"moon","text":"For a time, their numbers increased explosively in Alola. Since the arrival of Grimer, their population has decreased dramatically."},{"version":"ultra-sun","text":"It locks opponents in place with its left hand, immobilizing them by entirely dousing their bodies with poisonous liquid."},{"version":"ultra-moon","text":"Some say the reason Garbodor in Alola are a little stronger than their counterparts elsewhere is the presence of Muk, their natural enemy."},{"version":"sword","text":"This Pokémon eats trash, which turns into poison inside its body. The main component of the poison depends on what sort of trash was eaten."},{"version":"shield","text":"The toxic liquid it launches from its right arm is so virulent that it can kill a weakened creature instantly."}],"genderRate":4,"captureRate":60,"eggGroups":["mineral"],"isLegendary":false,"isMythical":false,"evolution":{"species":"trubbish","speciesId":568,"evolvesTo":[{"conditions":["Nível 36"],"species":"garbodor","speciesId":569,"evolvesTo":[]}]},"varieties":[{"id":569,"name":"garbodor","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/569.png"},{"id":10207,"name":"garbodor-gmax","form":"gmax","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10207.png"}],"games":[11,14,15,16,17,18,20],"moves":[{"id":1,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1]]},{"id":3,"learn":[[11,"lv",14],[14,"lv",14],[15,"lv",14],[16,"lv",14],[17,"lv",14],[18,"lv",14]]},{"id":34,"learn":[[11,"lv",25],[14,"lv",25],[15,"lv",25],[16,"lv",25],[17,"lv",25],[18,"lv",25],[20,"lv",24],[20,"tm",0]]},{"id":36,"learn":[[20,"lv",1]]},{"id":63,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":76,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":85,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":92,"learn":[[11,"lv",39],[11,"tm",0],[14,"lv",39],[14,"tm",0],[15,"lv",39],[15,"tm",0],[16,"lv",39],[16,"tm",0],[17,"lv",39],[17,"tm",0],[18,"lv",39],[18,"tm",0],[20,"lv",30]]},{"id":94,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":103,"learn":[[20,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":120,"learn":[[20,"tm",0]]},{"id":124,"learn":[[11,"lv",18],[14,"lv",18],[15,"lv",18],[