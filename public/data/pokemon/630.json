{"id":630,"name":"mandibuzz","speciesId":630,"dex":630,"form":"normal","generation":5,"types":["dark","flying"],"stats":{"hp":110,"attack":65,"defense":105,"special-attack":55,"special-defense":95,"speed":80},"abilities":[{"name":"big-pecks","hidden":false},{"name":"overcoat","hidden":false},{"name":"weak-armor","hidden":true}],"height":12,"weight":395,"baseExp":179,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/630.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/630.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/630.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/630.ogg","genus":"Bone Vulture Pokémon","flavor":[{"version":"black","text":"It makes a nest out of bones it finds. It grabs weakened prey in its talons and hauls it to its nest of bones."},{"version":"white","text":"Watching from the sky, they swoop to strike weakened Pokémon on the ground. They decorate themselves with bones."},{"version":"black-2","text":"They fly in circles around the sky. When they spot prey, they attack and carry it back to their nest with ease."},{"version":"sun","text":"They adorn themselves beautifully with bones. This is supposedly an effort to attract males, but no male Mandibuzz have ever been found."},{"version":"moon","text":"It circles in the sky, keeping a keen eye out for Pokémon in a weakened state. Its choicest food is Cubone."},{"version":"ultra-sun","text":"It skillfully arranges the bones of its prey to construct its nest. Most of the bones are Cubone."},{"version":"ultra-moon","text":"It’s always searching for food for Vullaby. When it finds a weak Pokémon, Mandibuzz swoops it right off to its nest."},{"version":"sword","text":"Although it’s a bit of a ruffian, this Pokémon will take lost Vullaby under its wing and care for them till they’re ready to leave the nest."},{"version":"shield","text":"They adorn themselves with bones. There seem to be fashion trends among them, as different bones come into and fall out of popularity."}],"genderRate":8,"captureRate":60,"eggGroups":["flying"],"isLegendary":false,"isMythical":false,"evolution":{"species":"vullaby","speciesId":629,"evolvesTo":[{"conditions":["Nível 54"],"species":"mandibuzz","speciesId":630,"evolvesTo":[]}]},"varieties":[{"id":630,"name":"mandibuzz","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/630.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":15,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":16,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":18,"learn":[[11,"lv",57],[14,"lv",57],[15,"lv",1],[15,"lv",57],[16,"lv",1],[16,"lv",57],[17,"lv",1],[17,"lv",57],[18,"lv",1],[18,"lv",57],[20,"lv",36],[25,"lv",36]]},{"id":19,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":31,"learn":[[11,"lv",1],[11,"lv",5],[14,"lv",1],[14,"lv",5],[15,"lv",1],[15,"lv",5],[16,"lv",1],[16,"lv",5],[17,"lv",1],[17,"lv",5],[18,"lv",1],[18,"lv",5]]},{"id":36,"learn":[[25,"tm",0]]},{"id":38,"learn":[[25,"tm",0]]},{"id":43,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":63,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"lv",1],[25,"lv",1],[25,"egg",0],[25,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":119,"learn":[[11,"lv",70],[14,"lv",70],[15,"lv",1],[15,"lv",70],[16,"lv",1],[16,"lv",70],[17,"lv",1],[17,"lv",70],[18,"lv",1],[18,"lv",70]]},{"id":129,"learn":[[20,"tm",0],[25,"tm",0]]},{"id"