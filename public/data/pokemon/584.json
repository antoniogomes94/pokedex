{"id":584,"name":"vanilluxe","speciesId":584,"dex":584,"form":"normal","generation":5,"types":["ice"],"stats":{"hp":71,"attack":95,"defense":85,"special-attack":110,"special-defense":95,"speed":79},"abilities":[{"name":"ice-body","hidden":false},{"name":"snow-warning","hidden":false},{"name":"weak-armor","hidden":true}],"height":13,"weight":575,"baseExp":241,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/584.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/584.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/584.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/584.ogg","genus":"Snowstorm Pokémon","flavor":[{"version":"black","text":"Swallowing large amounts of water, they make snow clouds inside their bodies and attack their foes with violent blizzards."},{"version":"white","text":"If both heads get angry simultaneously, this Pokémon expels a blizzard, burying everything in snow."},{"version":"black-2","text":"Swallowing large amounts of water, they make snow clouds inside their bodies and, when angry, cause violent blizzards."},{"version":"sun","text":"Each of its two heads has a brain, and when they are in agreement, it attacks its enemies by exhaling a violent blizzard."},{"version":"moon","text":"Even if it loses one of its heads, it can live relatively problem-free. It makes snow clouds inside its body."},{"version":"ultra-sun","text":"It blasts blizzards from its two mouths. It can create snow anywhere, so it gets a lot of love from skiers and snowboarders."},{"version":"ultra-moon","text":"Vanilluxe is born when two Vanillish, half-melted by the day’s light, stick to each other and freeze together in the cold return of night."},{"version":"sword","text":"When its anger reaches a breaking point, this Pokémon unleashes a fierce blizzard that freezes every creature around it, be they friend or foe."},{"version":"shield","text":"People believe this Pokémon formed when two Vanillish stuck together. Its body temperature is roughly 21 degrees Fahrenheit."}],"genderRate":4,"captureRate":45,"eggGroups":["mineral"],"isLegendary":false,"isMythical":false,"evolution":{"species":"vanillite","speciesId":582,"evolvesTo":[{"conditions":["Nível 35"],"species":"vanillish","speciesId":583,"evolvesTo":[{"conditions":["Nível 47"],"species":"vanilluxe","speciesId":584,"evolvesTo":[]}]}]},"varieties":[{"id":584,"name":"vanilluxe","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/584.png"}],"games":[11,14,15,16,17,18,20],"moves":[{"id":54,"learn":[[11,"lv",16],[14,"lv",16],[15,"lv",16],[16,"lv",16],[17,"lv",16],[18,"lv",16],[20,"lv",1]]},{"id":58,"learn":[[11,"lv",36],[11,"tm",0],[14,"lv",36],[14,"tm",0],[15,"lv",36],[15,"tm",0],[16,"lv",36],[16,"tm",0],[17,"lv",36],[17,"tm",0],[18,"lv",36],[18,"tm",0],[20,"lv",44],[20,"tm",0]]},{"id":59,"learn":[[11,"lv",59],[11,"tm",0],[14,"lv",59],[14,"tm",0],[15,"lv",59],[15,"tm",0],[16,"lv",59],[16,"tm",0],[17,"lv",59],[17,"tm",0],[18,"lv",59],[18,"tm",0],[20,"lv",52],[20,"tm",0]]},{"id":63,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":106,"learn":[[11,"lv",1],[11,"lv",4],[14,"lv",1],[14,"lv",4],[15,"lv",1],[15,"lv",4],[16,"lv",1],[16,"lv",4],[17,"lv",1],[17,"lv",4],[18,"lv",1],[18,"lv",4],[20,"lv",1]]},{"id":113,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":120,"learn":[[20,"tm",0]]},{"id":151,"learn":[[11,"lv",31],[14,"lv",31],[15,"lv",31],[16,"lv",31],[17,"lv",31],[18,"lv",31],[20,"lv",32]]},{"id":153,"learn":[[11,"tm",0],[14,"tm",0],