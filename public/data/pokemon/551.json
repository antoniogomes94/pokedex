{"id":551,"name":"sandile","speciesId":551,"dex":551,"form":"normal","generation":5,"types":["ground","dark"],"stats":{"hp":50,"attack":72,"defense":35,"special-attack":35,"special-defense":35,"speed":65},"abilities":[{"name":"intimidate","hidden":false},{"name":"moxie","hidden":false},{"name":"anger-point","hidden":true}],"height":7,"weight":152,"baseExp":58,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/551.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/551.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/551.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/551.ogg","genus":"Desert Croc Pokémon","flavor":[{"version":"black","text":"They live buried in the sands of the desert. The sun-warmed sands prevent their body temperature from dropping."},{"version":"white","text":"It moves along below the sand’s surface, except for its nose and eyes. A dark membrane shields its eyes from the sun."},{"version":"black-2","text":"They live hidden under hot desert sands in order to keep their body temperature from dropping."},{"version":"sun","text":"It submerges itself in sand and moves as if swimming. This wise behavior keeps its enemies from finding it and maintains its temperature."},{"version":"moon","text":"It conceals itself in the sand and chomps down on the legs of any prey that unwarily walk over it. Its favorite food is Trapinch."},{"version":"ultra-sun","text":"Alola, where it’s warm all year round, is a comfortable environment for this Pokémon. Sometimes you’ll even see it outside of deserts."},{"version":"ultra-moon","text":"Sandile’s still not good at hunting, so it mostly eats things that have collapsed in the desert. It’s called “the cleaner of the desert.”"},{"version":"sword","text":"The desert gets cold at night, so when the sun sets, this Pokémon burrows deep into the sand and sleeps until sunrise."},{"version":"shield","text":"Sandile is small, but its legs and lower body are powerful. Pushing sand aside as it goes, Sandile moves through the desert as if it’s swimming."}],"genderRate":4,"captureRate":180,"eggGroups":["ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"sandile","speciesId":551,"evolvesTo":[{"conditions":["Nível 29"],"species":"krokorok","speciesId":552,"evolvesTo":[{"conditions":["Nível 40"],"species":"krookodile","speciesId":553,"evolvesTo":[]}]}]},"varieties":[{"id":551,"name":"sandile","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/551.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":15,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":28,"learn":[[11,"lv",7],[14,"lv",7],[15,"lv",7],[16,"lv",7],[17,"lv",7],[18,"lv",7],[20,"lv",3],[25,"lv",3]]},{"id":34,"learn":[[25,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":37,"learn":[[11,"lv",46],[14,"lv",46],[15,"lv",46],[16,"lv",46],[17,"lv",46],[18,"lv",46],[20,"lv",39],[25,"lv",39]]},{"id":38,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[25,"egg",0],[25,"tm",0]]},{"id":43,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":44,"learn":[[11,"lv",4],[14,"lv",4],[15,"lv",4],[16,"lv",4],[17,"lv",4],[18,"lv",4],[20,"lv",15],[25,"lv",15]]},{"id":46,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[25,"tm",0]]},{"id":68,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[25,"egg",0]]},{"id":89,"learn":[[11,"lv",43],[11,"tm",0],[14,"lv",43],[14,"tm",0],[15,"lv",43],[15,"tm",0],[16,"lv",43],[16,"tm",0],[17,"lv",43],[17,"tm",0],[18,"lv",43],[18,"tm",0],[20,"lv",36],[20,"tm",0],[25,"lv",36],[25,"tm",0]]},{"id":91,"learn":[[11,"lv",31],[11,"tm",0],[