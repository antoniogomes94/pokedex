{"id":737,"name":"charjabug","speciesId":737,"dex":737,"form":"normal","generation":7,"types":["bug","electric"],"stats":{"hp":57,"attack":82,"defense":95,"special-attack":55,"special-defense":75,"speed":36},"abilities":[{"name":"battery","hidden":false}],"height":5,"weight":105,"baseExp":140,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/737.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/737.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/737.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/737.ogg","genus":"Battery Pokémon","flavor":[{"version":"sun","text":"Its body is capable of storing electricity. On camping trips, people are grateful to have one around."},{"version":"moon","text":"From the food it digests, it generates electricity, and it stores this energy in its electric sac."},{"version":"ultra-sun","text":"It buries itself in fallen leaves and barely moves, munching away on humus. If you accidentally step on one, you’ll get a shock!"},{"version":"ultra-moon","text":"Its stout shell provides excellent defense from attacks. It uses electricity on persistent opponents."},{"version":"sword","text":"While its durable shell protects it from attacks, Charjabug strikes at enemies with jolts of electricity discharged from the tips of its jaws."},{"version":"shield","text":"Its digestive processes convert the leaves it eats into electricity. An electric sac in its belly stores the electricity for later use."}],"genderRate":4,"captureRate":120,"eggGroups":["bug"],"isLegendary":false,"isMythical":false,"evolution":{"species":"grubbin","speciesId":736,"evolvesTo":[{"conditions":["Nível 20"],"species":"charjabug","speciesId":737,"evolvesTo":[{"conditions":["Em Vast Poni Canyon","Em Blush Mountain","Usar Thunder Stone"],"species":"vikavolt","speciesId":738,"e