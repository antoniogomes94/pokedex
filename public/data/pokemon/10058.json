{"id":10058,"name":"garchomp-mega","speciesId":445,"dex":445,"form":"mega","generation":4,"types":["dragon","ground"],"stats":{"hp":108,"attack":170,"defense":115,"special-attack":120,"special-defense":95,"speed":92},"abilities":[{"name":"sand-force","hidden":false}],"height":19,"weight":950,"baseExp":315,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10058.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/10058.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/10058.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/10058.ogg","genus":"Mach Pokémon","flavor":[{"version":"diamond","text":"When it folds up its body and extends its wings, it looks like a jet plane. It flies at sonic speed."},{"version":"pearl","text":"It flies at speeds equal to a jet fighter plane. It never allows its prey to escape."},{"version":"platinum","text":"It is said that when one runs at high speed, its wings create blades of wind that can fell nearby trees."},{"version":"heartgold","text":"Its body is covered in fine scales that reduce drag, enabling it to fly at high speeds."},{"version":"sun","text":"It can fly at speeds rivaling jet planes. It dives into flocks of bird Pokémon and gulps the entire flock down whole."},{"version":"moon","text":"The protuberances on its head serve as sensors. It can even detect distant prey."},{"version":"ultra-sun","text":"It flies at the speed of sound while searching for prey, and it has midair battles with Salamence as the two compete for food."},{"version":"ultra-moon","text":"Its fine scales don’t just reduce wind resistance—their sharp edges also cause injury to any opponent who attacks it."},{"version":"sword","text":"Garchomp makes its home in volcanic mountains. It flies through the sky as fast as a jet airplane, hunting down as much prey as it can."},{"version":"shield","text":"Garchomp is fast both underground and above. It can bring down prey and return to its den before its body has chilled from being outside."},{"version":"legends-arceus","text":"Soars across the heavens at blinding speed—a magnificent sight! It has a feral disposition. Utmost caution is required if one meets a Garchomp out in the wilds."}],"genderRate":4,"captureRate":45,"eggGroups":["monster","dragon"],"isLegendary":false,"isMythical":false,"evolution":{"species":"gible","speciesId":443,"evolvesTo":[{"conditions":["Nível 24"],"species":"gabite","speciesId":444,"evolvesTo":[{"conditions":["Nível 48"],"species":"garchomp","speciesId":445,"evolvesTo":[]}]}]},"varieties":[{"id":445,"name":"garchomp","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/445.png"},{"id":10058,"name":"garchomp-mega","form":"mega","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10058.png"},{"id":10309,"name":"garchomp-mega-z","form":"mega","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10309.png"}],"games":[15,16,17,18],"moves":[{"id":14,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":15,"learn":[[15,"tm",0],[16,"tm",0]]},{"id":28,"learn":[[15,"lv",1],[15,"lv",3],[16,"lv",1],[16,"lv",3],[17,"lv",1],[17,"lv",3],[18,"lv",1],[18,"lv",3]]},{"id":33,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1]]},{"id":36,"learn":[[15,"lv",15],[16,"lv",15],[17,"lv",15],[18,"lv",15]]},{"id":46,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":53,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":57,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":63,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":70,"learn":[[15,"tm",0],[16,"tm",0]]},{"id":82,"learn":[[15,"lv",1],[15,"lv",7],[16,"lv",1],[16,"lv",7],[17,"lv"