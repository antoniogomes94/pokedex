{"id":570,"name":"zorua","speciesId":570,"dex":570,"form":"normal","generation":5,"types":["dark"],"stats":{"hp":40,"attack":65,"defense":40,"special-attack":80,"special-defense":40,"speed":65},"abilities":[{"name":"illusion","hidden":false}],"height":7,"weight":125,"baseExp":66,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/570.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/570.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/570.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/570.ogg","genus":"Tricky Fox Pokémon","flavor":[{"version":"black","text":"It changes into the forms of others to surprise them. Apparently, it often transforms into a silent child."},{"version":"white","text":"To protect themselves from danger, they hide their true identities by transforming into people and Pokémon."},{"version":"black-2","text":"It changes so it looks just like its foe, tricks it, and then uses that opportunity to flee."},{"version":"ultra-sun","text":"This Pokémon has a cowardly disposition, so when it’s not around friends, it basically always stays transformed as something else."},{"version":"ultra-moon","text":"If a normally talkative child suddenly stops talking, it may have been replaced by Zorua."},{"version":"sword","text":"Zorua is a timid Pokémon. This disposition seems to be what led to the development of Zorua’s ability to take on the forms of other creatures."},{"version":"shield","text":"Zorua sometimes transforms into a person and goes into cities to search for food. When Zorua does this, it usually takes on the form of a child."},{"version":"legends-arceus","text":"A once-departed soul, returned to life in Hisui. Derives power from resentment, which rises as energy atop its head and takes on the forms of foes. In this way, Zorua vents lingering malice."}],"genderRate":1,"captureRate":75,"eggGroups":["ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"zorua","speciesId":570,"evolvesTo":[{"conditions":["Nível 30","Nível 30"],"species":"zoroark","speciesId":571,"evolvesTo":[]}]},"varieties":[{"id":570,"name":"zorua","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/570.png"},{"id":10238,"name":"zorua-hisui","form":"hisuian","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10238.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":10,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":14,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":15,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":43,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":46,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[25,"tm",0]]},{"id":68,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[25,"egg",0]]},{"id":91,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":97,"learn":[[11,"lv",37],[14,"lv",37],[15,"lv",37],[16,"lv",37],[17,"lv",37],[18,"lv",37],[20,"lv",32],[20,"tm",0],[25,"lv",32],[25,"tm",0]]},{"id":101,"learn":[[25,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":109,"learn":[[25,"tm",0]]},{"id":129,"learn":[[20,"tm",0],[25,"tm",0]]},{"id":154,"learn":[[11,"lv",13],[14,"lv",13],[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13],[20,"lv",12],[25,"lv",12]]},{"id":156,"learn":[[11,"tm"