{"id":10088,"name":"lopunny-mega","speciesId":428,"dex":428,"form":"mega","generation":4,"types":["normal","fighting"],"stats":{"hp":65,"attack":136,"defense":94,"special-attack":54,"special-defense":96,"speed":135},"abilities":[{"name":"scrappy","hidden":false}],"height":13,"weight":283,"baseExp":203,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10088.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/10088.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/10088.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/10088.ogg","genus":"Rabbit Pokémon","flavor":[{"version":"diamond","text":"An extremely cautious Pokémon. It cloaks its body with its fluffy ear fur when it senses danger."},{"version":"pearl","text":"It is very conscious of its looks and never fails to groom its ears. It runs with sprightly jumps."},{"version":"platinum","text":"The ears appear to be delicate. If they are touched roughly, it kicks with its graceful legs."},{"version":"heartgold","text":"It sheds its fur twice a year. Its winter fur is soft and fluffy."},{"version":"black-2","text":"Extremely cautious, it quickly bounds off when it senses danger."},{"version":"ultra-sun","text":"Lopunny regrows its coat twice a year. Mufflers and hats made from its fur are really warm."},{"version":"ultra-moon","text":"It’s notably wary and has a dislike of fighting, but at the same time, it can deliver powerful kicks with its lithe legs."},{"version":"sword","text":"Lopunny is constantly monitoring its surroundings. If danger approaches, this Pokémon responds with superdestructive kicks."},{"version":"shield","text":"Once hot seasons are over, Lopunny’s coat will be replaced with fur that holds a lot of insulating air in preparation for colder weather."},{"version":"legends-arceus","text":"Its fur is warm and yet remarkably light. This Pokémon kicks as though it were a master of karate, driving back its opponents with ease."}],"genderRate":4,"captureRate":60,"eggGroups":["ground","humanshape"],"isLegendary":false,"isMythical":false,"evolution":{"species":"buneary","speciesId":427,"evolvesTo":[{"conditions":["Felicidade alta"],"species":"lopunny","speciesId":428,"evolvesTo":[]}]},"varieties":[{"id":428,"name":"lopunny","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/428.png"},{"id":10088,"name":"lopunny-mega","form":"mega","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10088.png"}],"games":[16,17,18],"moves":[{"id":1,"learn":[[16,"lv",1],[17,"lv",1],[18,"lv",1]]},{"id":7,"learn":[[16,"tutor",0],[18,"tutor",0]]},{"id":8,"learn":[[16,"tutor",0],[18,"tutor",0]]},{"id":9,"learn":[[16,"tutor",0],[18,"tutor",0]]},{"id":15,"learn":[[16,"tm",0]]},{"id":26,"learn":[[16,"lv",23],[17,"lv",23],[18,"lv",23]]},{"id":58,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":59,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":63,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":67,"learn":[[16,"tutor",0],[18,"tutor",0]]},{"id":70,"learn":[[16,"tm",0]]},{"id":76,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":85,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":86,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":87,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":91,"learn":[[16,"tm",0]]},{"id":92,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":97,"learn":[[16,"lv",33],[17,"lv",33],[18,"lv",33]]},{"id":98,"learn":[[16,"lv",16],[17,"lv",16],[18,"lv",16]]},{"id":104,"learn":[[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":111,"learn":[[16,"lv",1],[17,"lv",1],[18,"lv",1]]},{"id":136,"learn":[[16,"lv",66],[17,"lv",66],[18,"lv",66]]},{"id":146,"learn":[[16,"lv",36],[17,"lv",36],[18,"lv",36]]},{"id":150,"learn":[[16,"lv",1],[17,"lv",1