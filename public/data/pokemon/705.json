{"id":705,"name":"sliggoo","speciesId":705,"dex":705,"form":"normal","generation":6,"types":["dragon"],"stats":{"hp":68,"attack":75,"defense":53,"special-attack":83,"special-defense":113,"speed":60},"abilities":[{"name":"sap-sipper","hidden":false},{"name":"hydration","hidden":false},{"name":"gooey","hidden":true}],"height":8,"weight":175,"baseExp":158,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/705.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/705.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/705.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/705.ogg","genus":"Soft Tissue Pokémon","flavor":[{"version":"x","text":"It drives away opponents by excreting a sticky liquid that can dissolve anything. Its eyes devolved, so it can’t see anything."},{"version":"y","text":"Its four horns are a high-performance radar system. It uses them to sense sounds and smells, rather than using ears or a nose."},{"version":"sun","text":"It has trouble drawing a line between friends and food. It will calmly try to melt and eat even those it gets along well with."},{"version":"moon","text":"This Pokémon’s mucous can dissolve anything. Toothless, it sprays mucous on its prey. Once they’re nicely dissolved, it slurps them up."},{"version":"ultra-sun","text":"It crawls along sluggishly. The swirly protrusion on its back is filled with its brain and other organs."},{"version":"ultra-moon","text":"Its entire body is covered with gooey mucus that can dissolve anything. Be sure to put gloves on if you’re going to touch it."},{"version":"sword","text":"Although this Pokémon isn’t very strong, its body is coated in a caustic slime that can melt through anything, so predators steer clear of it."},{"version":"shield","text":"The lump on its back contains its tiny brain. It thinks only of food and escaping its enemies."},{"version":"legends-arceus","text":"A creature given to melancholy. I suspect its metallic shell developed as a result of the mucus on its skin reacting with the iron in Hisui's water."}],"genderRate":4,"captureRate":45,"eggGroups":["dragon"],"isLegendary":false,"isMythical":false,"evolution":{"species":"goomy","speciesId":704,"evolvesTo":[{"conditions":["Nível 40","Nível 40"],"species":"sliggoo","speciesId":705,"evolvesTo":[{"conditions":["Nível 50, Chovendo","Nível 50, Chovendo"],"species":"goodra","speciesId":706,"evolvesTo":[]}]}]},"varieties":[{"id":705,"name":"sliggoo","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/705.png"},{"id":10241,"name":"sliggoo-hisui","form":"hisuian","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10241.png"}],"games":[15,16,17,18,20,25],"moves":[{"id":33,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":34,"learn":[[15,"lv",32],[16,"lv",32],[17,"lv",32],[18,"lv",32],[20,"lv",49],[20,"tm",0],[25,"lv",49],[25,"tm",0]]},{"id":36,"learn":[[25,"tm",0]]},{"id":55,"learn":[[20,"lv",1],[25,"lv",1]]},{"id":58,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":59,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":71,"learn":[[15,"lv",5],[16,"lv",5],[17,"lv",1],[17,"lv",5],[18,"lv",1],[18,"lv",5],[20,"lv",1],[25,"lv",1]]},{"id":85,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":87,"learn":[[25,"tm",0]]},{"id":92,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[25,"tm",0]]},{"id":104,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":117,"learn":[[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13]]},{"id":145,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1]]},{"id":151,"learn":[[25,"lv",1]]},{