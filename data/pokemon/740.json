{"id":740,"name":"crabominable","speciesId":740,"dex":740,"form":"normal","generation":7,"types":["fighting","ice"],"stats":{"hp":97,"attack":132,"defense":77,"special-attack":62,"special-defense":67,"speed":43},"abilities":[{"name":"hyper-cutter","hidden":false},{"name":"iron-fist","hidden":false},{"name":"anger-point","hidden":true}],"height":17,"weight":1800,"baseExp":167,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/740.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/740.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/740.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/740.ogg","genus":"Woolly Crab Pokémon","genusPt":"Pokémon Caranguejo Lanoso","flavor":[{"version":"sun","text":"It aimed for the top but got lost and ended up on a snowy mountain. Being forced to endure the cold, this Pokémon evolved and grew fur."},{"version":"moon","text":"It just throws punches indiscriminately. In times of desperation, it can lop off its own pincers and fire them like rockets."},{"version":"ultra-sun","text":"It stores coldness in its pincers and pummels its foes. It can even smash thick walls of ice to bits!"},{"version":"ultra-moon","text":"Before it stops to think, it just starts pummeling. There are records of its turning back avalanches with a flurry of punches."}],"flavorPt":"Antes de parar para pensar, ele simplesmente começa a atacar. Há registros de que ele recuou de avalanches com uma série de socos.","genderRate":4,"captureRate":60,"eggGroups":["water3"],"isLegendary":false,"isMythical":false,"evolution":{"species":"crabrawler","speciesId":739,"evolvesTo":[{"conditions":["Em Mount Lanakila","Usar Ice Stone"],"species":"crabominable","speciesId":740,"evolvesTo":[]}]},"varieties":[{"id":740,"name":"crabominable","form":"normal","sprite":"https://raw.github