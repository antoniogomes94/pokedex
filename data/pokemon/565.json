{"id":565,"name":"carracosta","speciesId":565,"dex":565,"form":"normal","generation":5,"types":["water","rock"],"stats":{"hp":74,"attack":108,"defense":133,"special-attack":83,"special-defense":65,"speed":32},"abilities":[{"name":"solid-rock","hidden":false},{"name":"sturdy","hidden":false},{"name":"swift-swim","hidden":true}],"height":12,"weight":810,"baseExp":173,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/565.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/565.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/565.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/565.ogg","genus":"Prototurtle Pokémon","genusPt":"Pokémon prototartaruga","flavor":[{"version":"black","text":"They can live both in the ocean and on land. A slap from one of them is enough to open a hole in the bottom of a tanker."},{"version":"white","text":"Incredible jaw strength enables them to chew up steel beams and rocks along with their prey."},{"version":"black-2","text":"It could knock out a foe with a slap from one of its developed front appendages and chew it up, shell or bones and all."},{"version":"sun","text":"It constructed its sturdy shell by crunching and swallowing the hard shells or bones of its prey."},{"version":"moon","text":"Active both on land and in the sea, this Pokémon drags its land-based prey into the water to finish it off."},{"version":"ultra-sun","text":"Its jaws are terrifyingly powerful. It could eat Omastar and Omanyte whole and not be bothered in the slightest by their shells."},{"version":"ultra-moon","text":"Carracosta eats every last bit of the prey it catches, even the shells and bones, to further strengthen its sturdy shell."},{"version":"sword","text":"Carracosta completely devours its prey—bones, shells, and all. Because of this, Carracosta’s own shell grows thick and sturdy."},{"version":"shield","text":"This Pokémon emerges from the water in search of prey despite the fact that it moves more slowly on land."}],"flavorPt":"Este Pokémon emerge da água em busca de presas, apesar de se mover mais lentamente em terra.","genderRate":1,"captureRate":45,"eggGroups":["water1","water3"],"isLegendary":false,"isMythical":false,"evolution":{"species":"tirtouga","speciesId":564,"evolvesTo":[{"conditions":["Nível 37"],"species":"carracosta","speciesId":565,"evolvesTo":[]}]},"varieties":[{"id":565,"name":"carracosta","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/565.png"}],"games":[11,14,15,16,17,18,20],"moves":[{"id":34,"learn":[[20,"tm",0]]},{"id":44,"learn":[[11,"lv",8],[14,"lv",8],[15,"lv",8],[16,"lv",8],[17,"lv",8],[18,"lv",8],[20,"lv",15]]},{"id":55,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1]]},{"id":56,"learn":[[11,"lv",61],[14,"lv",61],[15,"lv",61],[16,"lv",61],[17,"lv",61],[18,"lv",61],[20,"lv",46],[20,"tm",0]]},{"id":57,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":58,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":59,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":63,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":67,"learn":[[14,"tutor",0],[16,"tutor",0],[18,"tutor",0],[20,"tm",0]]},{"id":70,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0]]},{"id":89,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0]]},{"id":91,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[20,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm