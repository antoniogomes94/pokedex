{"id":618,"name":"stunfisk","speciesId":618,"dex":618,"form":"normal","generation":5,"types":["ground","electric"],"stats":{"hp":109,"attack":66,"defense":84,"special-attack":81,"special-defense":99,"speed":32},"abilities":[{"name":"static","hidden":false},{"name":"limber","hidden":false},{"name":"sand-veil","hidden":true}],"height":7,"weight":110,"baseExp":165,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/618.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/618.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/618.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/618.ogg","genus":"Trap Pokémon","genusPt":"Armadilha Pokémon","flavor":[{"version":"black","text":"Its skin is very hard, so it is unhurt even if stepped on by sumo wrestlers. It smiles when transmitting electricity."},{"version":"white","text":"It conceals itself in the mud of the seashore. Then it waits. When prey touch it, it delivers a jolt of electricity."},{"version":"black-2","text":"When its opponent can’t be paralyzed, it contorts itself with unexpected speed and flops away."},{"version":"sword","text":"Thanks to bacteria that lived in the mud flats with it, this Pokémon developed the organs it uses to generate electricity."},{"version":"shield","text":"For some reason, this Pokémon smiles slightly when it emits a strong electric current from the yellow markings on its body."}],"flavorPt":"Por alguma razão, este Pokémon sorri levemente quando emite uma forte corrente elétrica a partir das marcas amarelas em seu corpo.","genderRate":4,"captureRate":75,"eggGroups":["water1","indeterminate"],"isLegendary":false,"isMythical":false,"evolution":{"species":"stunfisk","speciesId":618,"evolvesTo":[]},"varieties":[{"id":618,"name":"stunfisk","form":"normal","sprite":"https://raw.githubusercontent.com