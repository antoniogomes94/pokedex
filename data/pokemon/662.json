{"id":662,"name":"fletchinder","speciesId":662,"dex":662,"form":"normal","generation":6,"types":["fire","flying"],"stats":{"hp":62,"attack":73,"defense":55,"special-attack":56,"special-defense":52,"speed":84},"abilities":[{"name":"flame-body","hidden":false},{"name":"gale-wings","hidden":true}],"height":7,"weight":160,"baseExp":134,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/662.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/662.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/662.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/662.ogg","genus":"Ember Pokémon","genusPt":"Pokémon Brasa","flavor":[{"version":"x","text":"From its beak, it expels embers that set the tall grass on fire. Then it pounces on the bewildered prey that pop out of the grass."},{"version":"y","text":"The hotter the flame sac on its belly, the faster it can fly, but it takes some time to get the fire going."},{"version":"sun","text":"From its beak, it fires embers at its prey. Once it has caught them, it grills them at high heat before feasting upon them."},{"version":"moon","text":"It will not tolerate other Fletchinder entering its territory, which has a radius of several miles."},{"version":"ultra-sun","text":"It scatters embers in the tall grass. Then bug Pokémon, frightened by the flames, come flying out, and Fletchinder gobbles them up."},{"version":"ultra-moon","text":"Its speed right after takeoff already puts it in the top speed class of all bird Pokémon."},{"version":"sword","text":"Fletchinder launches embers into the den of its prey. When the prey comes leaping out, Fletchinder’s sharp talons finish it off."},{"version":"shield","text":"Fletchinder are exceedingly territorial and aggressive. These Pokémon fight among themselves over feeding grounds."}],"flavorPt":"Fletchinder é extremamente territorial e agressivo. Esses Pokémon lutam entre si por áreas de alimentação.","genderRate":4,"captureRate":120,"eggGroups":["flying"],"isLegendary":false,"isMythical":false,"evolution":{"species":"fletchling","speciesId":661,"evolvesTo":[{"conditions":["Nível 17"],"species":"fletchinder","speciesId":662,"evolvesTo":[{"conditions":["Nível 35"],"species":"talonflame","speciesId":663,"evolvesTo":[]}]}]},"varieties":[{"id":662,"name":"fletchinder","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/662.png"}],"games":[15,16,17,18,20,25],"moves":[{"id":13,"learn":[[15,"lv",27],[16,"lv",27],[17,"lv",27],[18,"lv",27]]},{"id":14,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":19,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"lv",64],[20,"tm",0],[25,"lv",64],[25,"tm",0]]},{"id":33,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1]]},{"id":36,"learn":[[25,"tm",0]]},{"id":38,"learn":[[25,"tm",0]]},{"id":45,"learn":[[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":52,"learn":[[15,"lv",17],[16,"lv",17],[17,"lv",0],[17,"lv",1],[18,"lv",0],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":53,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":64,"learn":[[15,"lv",10],[16,"lv",10],[17,"lv",10],[18,"lv",10],[20,"lv",1],[25,"lv",1]]},{"id":83,"learn":[[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":97,"learn":[[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13],[20,"lv",29],[20,"tm",0],[25,"lv",29],[25,"tm",0]]},{"id":98,"learn":[[15,"lv",6],[16,"lv",6],[17,"lv",1],[17,"lv",6],[18,"lv",1],[18,"lv",6],[20,"lv",1],[25,"lv",1]]},{"id":104,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":126,"learn":[[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":129,"learn":[[20,"tm",0],[25