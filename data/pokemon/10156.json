{"id":10156,"name":"necrozma-dawn","speciesId":800,"dex":800,"form":"other","generation":7,"types":["psychic","ghost"],"stats":{"hp":97,"attack":113,"defense":109,"special-attack":157,"special-defense":127,"speed":77},"abilities":[{"name":"prism-armor","hidden":false}],"height":42,"weight":3500,"baseExp":340,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10156.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/10156.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/10156.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/10156.ogg","genus":"Prism Pokémon","genusPt":"Pokémon Prisma","flavor":[{"version":"sun","text":"Reminiscent of the Ultra Beasts, this life-form, apparently asleep underground, is thought to have come from another world in ancient times."},{"version":"moon","text":"Light is apparently the source of its energy. It has an extraordinarily vicious disposition and is constantly firing off laser beams."},{"version":"ultra-sun","text":"It looks somehow pained as it rages around in search of light, which serves as its energy. It’s apparently from another world."},{"version":"ultra-moon","text":"Light is the source of its energy. If it isn’t devouring light, impurities build up in it and on it, and Necrozma darkens and stops moving."},{"version":"sword","text":"It survives by absorbing light. After a long time spent slumbering underground, impurities accumulated within it, causing its body to darken."},{"version":"shield","text":"It needs light to survive, and it goes on a rampage seeking it out. Its laser beams will cut anything to pieces."}],"flavorPt":"Ele precisa de luz para sobreviver e fica furioso em busca dela. Seus raios laser cortarão qualquer coisa em pedaços.","genderRate":-1,"captureRate":255,"eggGroups":["no-eggs"],"isLegendary":true,"isMythical":false,"evolution":{"species":"necrozma","speciesId":800,"evolvesTo":[]},"varieties":[{"id":800,"name":"necrozma","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/800.png"},{"id":10155,"name":"necrozma-dusk","form":"other","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10155.png"},{"id":10156,"name":"necrozma-dawn","form":"other","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10156.png"},{"id":10157,"name":"necrozma-ultra","form":"other","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/10157.png"}],"games":[18,20,25],"moves":[{"id":14,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":34,"learn":[[25,"tm",0]]},{"id":63,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":76,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":86,"learn":[[18,"tm",0],[20,"tm",0]]},{"id":89,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[18,"tm",0]]},{"id":93,"learn":[[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":94,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":104,"learn":[[18,"tm",0]]},{"id":113,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":115,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":129,"learn":[[25,"tm",0]]},{"id":156,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":157,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":163,"learn":[[18,"lv",7],[20,"lv",16],[25,"lv",16]]},{"id":164,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":168,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":173,"learn":[[18,"tutor",0],[20,"tm",0]]},{"id":182,"learn":[[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":184,"learn":[[20,"tm",0],[25,"tm",0]]},{"id":200,"learn":[[18,"tutor",0],[20,"tm",0],[25,"tm",0]]},{"id":201,"learn":[[25,"tm",0]]},{"id":203,"learn":[[20,"tm",0],[25,"tm",0]]},{"id":207,"learn