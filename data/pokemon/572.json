{"id":572,"name":"minccino","speciesId":572,"dex":572,"form":"normal","generation":5,"types":["normal"],"stats":{"hp":55,"attack":50,"defense":40,"special-attack":40,"special-defense":40,"speed":75},"abilities":[{"name":"cute-charm","hidden":false},{"name":"technician","hidden":false},{"name":"skill-link","hidden":true}],"height":4,"weight":58,"baseExp":60,"sprites":{"normal":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/572.png","shiny":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/shiny/572.png","icon":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/572.png"},"cry":"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/572.ogg","genus":"Chinchilla Pokémon","genusPt":"Pokémon chinchila","flavor":[{"version":"black","text":"They greet one another by rubbing each other with their tails, which are always kept well groomed and clean."},{"version":"white","text":"These Pokémon prefer a tidy habitat. They are always sweeping and dusting, using their tails as brooms."},{"version":"black-2","text":"Minccino greet each other by grooming one another thoroughly with their tails."},{"version":"ultra-sun","text":"A clean freak that will not allow even the slightest mess, it uses its tail like a mop to thoroughly clean any and all filth."},{"version":"ultra-moon","text":"When its tail has gotten dirty from self-cleaning or from cleaning its nest, Minccino spends a whole day washing its tail in clean spring water."},{"version":"sword","text":"The way it brushes away grime with its tail can be helpful when cleaning. But its focus on spotlessness can make cleaning more of a hassle."},{"version":"shield","text":"They pet each other with their tails as a form of greeting. Of the two, the one whose tail is fluffier is a bit more boastful."}],"flavorPt":"Eles acariciam uns aos outros com o rabo como forma de saudação. Dos dois, aquele que tem o rabo mais fofo é um pouco mais arrogante.","genderRate":6,"captureRate":255,"eggGroups":["ground"],"isLegendary":false,"isMythical":false,"evolution":{"species":"minccino","speciesId":572,"evolvesTo":[{"conditions":["Usar Shiny Stone"],"species":"cinccino","speciesId":573,"evolvesTo":[]}]},"varieties":[{"id":572,"name":"minccino","form":"normal","sprite":"https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/572.png"}],"games":[11,14,15,16,17,18,20,25],"moves":[{"id":1,"learn":[[11,"lv",1],[14,"lv",1],[15,"lv",1],[16,"lv",1],[17,"lv",1],[18,"lv",1],[20,"lv",1],[25,"lv",1]]},{"id":3,"learn":[[11,"lv",13],[14,"lv",13],[15,"lv",13],[16,"lv",13],[17,"lv",13],[18,"lv",13]]},{"id":21,"learn":[[11,"lv",37],[14,"lv",37],[15,"lv",37],[16,"lv",37],[17,"lv",37],[18,"lv",37],[20,"lv",40],[25,"lv",40]]},{"id":36,"learn":[[25,"tm",0]]},{"id":39,"learn":[[11,"egg",0],[14,"egg",0],[15,"egg",0],[16,"egg",0],[17,"egg",0],[18,"egg",0],[20,"egg",0],[25,"egg",0]]},{"id":45,"learn":[[11,"lv",3],[14,"lv",3]]},{"id":47,"learn":[[11,"lv",21],[14,"lv",21],[15,"lv",21],[16,"lv",21],[17,"lv",21],[18,"lv",21],[20,"lv",12],[25,"lv",12]]},{"id":85,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":86,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":91,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":92,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":104,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0]]},{"id":129,"learn":[[11,"lv",19],[14,"lv",19],[15,"lv",19],[16,"lv",19],[17,"lv",19],[18,"lv",19],[20,"lv",20],[20,"tm",0],[25,"lv",20],[25,"tm",0]]},{"id":156,"learn":[[11,"tm",0],[14,"tm",0],[15,"tm",0],[16,"tm",0],[17,"tm",0],[18,"tm",0],[20,"tm",0],[25,"tm",0]]},{"id":162,"learn":[[25,"tm",0]]},{"id":164,"learn":[